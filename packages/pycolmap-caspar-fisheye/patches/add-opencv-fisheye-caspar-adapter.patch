+            d.pose_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedPrincipalPointSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetOpencvFisheyeSplitFixedPrincipalPointFocalAndExtraIndicesFromHost(
+            d.focal_and_extra_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedPrincipalPointPointIndicesFromHost(
+            d.point_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedPrincipalPointPrincipalPointDataFromStackedHost(
+            d.const_principal_point.data(), 0, n);
+        s.SetOpencvFisheyeSplitFixedPrincipalPointPixelDataFromStackedHost(
+            d.pixels.data(), 0, n);
+        break;
+      case FactorVariant::FIXED_POINT:
+        s.SetOpencvFisheyeFixedPointNum(n);
+        s.SetOpencvFisheyeFixedPointPoseIndicesFromHost(d.pose_indices.data(),
+                                                       n);
+        s.SetOpencvFisheyeFixedPointSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetOpencvFisheyeFixedPointCalibIndicesFromHost(
