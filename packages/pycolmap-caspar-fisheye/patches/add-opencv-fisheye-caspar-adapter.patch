+def opencv_fisheye_core(
+    pose: T.Annotated[OpenCVFisheyePose, mem.TunableShared],
+    sensor_from_rig: T.Annotated[
+        ConstOpenCVFisheyeSensorFromRig, mem.ConstantSequential
+    ],
+    # [fx, fy, k1, k2, k3, k4, cx, cy]
+    calib: T.Annotated[OpenCVFisheyeCalib, mem.TunableShared],
+    point: T.Annotated[Point, mem.TunableShared],
+    pixel: T.Annotated[ConstPixel, mem.ConstantSequential],
+) -> sf.V2:
+    """Reprojection residual for COLMAP's OPENCV_FISHEYE model.
+
+    calib = [fx, fy, k1, k2, k3, k4, cx, cy] (focal_and_extra then
+    principal_point, per the merged-calib packing convention -- see
+    OpenCVFisheyeCalib's comment above; NOT camera.params'
+    [fx, fy, cx, cy, k1, k2, k3, k4] order).
+
+    Mirrors OpenCVFisheyeCameraModel in sensor/models.h, which composes
+    BasePerspectiveFisheyeCameraModel::FisheyeFromNormal (models.h:429-438),
+    Distortion (models.h:1660-1675) and ImgFromFisheye (models.h:1601-1611):
+
+        r     = |(u, v)|                      # u = X/Z, v = Y/Z
+        theta = atan(r)
+        (uu, vv) = (u, v) * theta / r         # FisheyeFromNormal
+        theta2   = uu^2 + vv^2                # already theta^2
+        radial   = k1*theta2 + k2*theta2^2 + k3*theta2^3 + k4*theta2^4
+        (x, y)   = (uu, vv) * (1 + radial)    # Distortion adds uu*radial
+        (X, Y)   = (fx*x + cx, fy*y + cy)     # ImgFromFisheye
+
+    i.e. the Kannala-Brandt polynomial
+    theta_d = theta * (1 + k1 theta^2 + k2 theta^4 + k3 theta^6 + k4 theta^8).
+
+    models.h guards the theta/r division with `if (r > epsilon)`; a branch does
+    not survive symbolic codegen, so `Matrix.norm(sf.epsilon())` is used
+    instead -- it computes sqrt(r^2 + epsilon), which keeps theta/r finite and
+    tends to 1 as r -> 0, the same limit the branch takes.  epsilon is 1e-6 for
+    f32 and 1e-15 for f64 (set at module load).
+
+    pose holds rig_from_world; sensor_from_rig is identity for single-camera
+    rigs (cam_from_world == rig_from_world in that case).
+    """
+    cam_T_world = sensor_from_rig * pose
+    fx, fy, k1, k2, k3, k4, cx, cy = calib
+    point_cam = cam_T_world * point
+    depth = point_cam[2]
+    p = sf.V2(point_cam[:2]) / (depth + sf.epsilon() * sf.sign_no_zero(depth))
+    r = p.norm(sf.epsilon())
+    theta = sf.atan(r)
+    theta2 = theta * theta
+    radial = theta2 * (k1 + theta2 * (k2 + theta2 * (k3 + theta2 * k4)))
+    scale = theta * (1 + radial) / r
+    return (
+        sf.V2([fx * scale * p[0] + cx, fy * scale * p[1] + cy]) - pixel
+    )
+
