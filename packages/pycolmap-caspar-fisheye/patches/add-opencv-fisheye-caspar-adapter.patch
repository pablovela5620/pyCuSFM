+# ---------------------------------------------------------------------------
+# Generator fix: guard the SumStore argument against padding threads.
+#
+# symforce 0.12.0's `AddSum.write_template`
+# (symforce/caspar/memory/accessors.py) closes the
+# `if (global_thread_idx < problem_size)` guard and only then emits
+#
+#     SumStore<float>(out_rTr_local, shared, 0, global_thread_idx < problem_size, r4);
+#
+# `r4` is a plain register assigned inside the guard, so the padding threads of
+# the last block pass an uninitialised value by value.  `SumStore` masks the
+# data (`valid ? data : 0`) but only after the argument has been evaluated, so
+# every score kernel reads an uninitialised register -- the hazard reported on
+# upstream COLMAP PR #4611.  Evaluating the argument conditionally removes the
+# read without changing the summed value: inactive threads already contribute
+# zero.
+#
+# The template lives in the symforce wheel, not in this repository, so the fix
+# is applied here as a subclass-free method replacement.  That keeps
+# regeneration self-contained: an unmodified `symforce==0.12.0` from PyPI plus
+# this script reproduce the generated tree byte for byte.
+def _add_sum_write_template(self: mem.AddSum, idx: int) -> str:
+    """Return the `SumStore` call with every summed argument guarded.
+
+    Args:
+        self: The `AddSum` (or `WriteSum`) accessor being written.
+        idx: Index of the chunk of the accessor's storage being written.
+
+    Returns:
+        The CUDA template text for this chunk.
+    """
+    common: Common = Common(self, idx)
+    guarded_args: str = ", ".join(
+        f"(global_thread_idx < problem_size ? {{arg_{i}}} : static_cast<{common.storage_t}>(0))"
+        for i in range(common.dim)
+    )
+    return f"""
+    }}}};
+    SumStore<{common.storage_t}>({self.name}_local, ({common.SharedT}*)inout_shared, {self.chunk_indices[idx][0]}, global_thread_idx < problem_size, {guarded_args});
+    if (global_thread_idx < problem_size) {{{{
+    """.strip()
+
+
+# `WriteSum` inherits `write_template` from `AddSum`, so both are covered.
+mem.AddSum.write_template = _add_sum_write_template
 
 
