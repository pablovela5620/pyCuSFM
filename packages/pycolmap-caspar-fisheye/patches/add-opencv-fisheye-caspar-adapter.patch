+// OpenCVFisheye implementation
+
+class OpenCVFisheyeAdapter : public ICasparModelAdapter {
+ public:
+  CameraModelId ModelId() const override {
+    return CameraModelId::kOpenCVFisheye;
+  }
+  // OPENCV_FISHEYE: params = [fx, fy, cx, cy, k1, k2, k3, k4]
+  // focal_and_extra = [fx, fy, k1, k2, k3, k4]  (non-contiguous in params)
+  // principal_point = [cx, cy]
+  // merged calib    = [fx, fy, k1, k2, k3, k4, cx, cy]
+  // Same arity as OPENCV (2 focal + 2 principal point + 4 extra), i.e. the
+  // largest merged Calib node Caspar is known to fit in 48 KB of shared
+  // memory.
+  size_t FocalAndExtraSize() const override { return 6; }
+  size_t PrincipalPointSize() const override { return 2; }
+  size_t CalibSize() const override {
+    return FocalAndExtraSize() + PrincipalPointSize();
+  }
+
+  void FillSizing(CasparSolverSizing& sz,
+                  const ModelData& md,
+                  size_t num_calibs) const override {
+    sz.num_opencv_fisheye_calibs = num_calibs;
+    for (int v = 0; v < CASPAR_NUM_VARIANTS; ++v) {
+      const size_t n = md.variants[v].num_factors;
+      switch (static_cast<FactorVariant>(v)) {
+        // Merged variants: both focal_and_extra and principal_point are
+        // tunable.
+        case FactorVariant::BASE:
+          sz.num_opencv_fisheye = n;
+          break;
+        case FactorVariant::FIXED_POSE:
+          sz.num_opencv_fisheye_fixed_pose = n;
+          break;
+        case FactorVariant::FIXED_POINT:
+          sz.num_opencv_fisheye_fixed_point = n;
+          break;
+        case FactorVariant::FIXED_POSE_FIXED_POINT:
+          sz.num_opencv_fisheye_fixed_pose_fixed_point = n;
+          break;
+        // Split variants: at least one intrinsic group is fixed.
+        case FactorVariant::FIXED_FOCAL_AND_EXTRA:
+          sz.num_opencv_fisheye_split_fixed_focal_and_extra = n;
+          break;
+        case FactorVariant::FIXED_PRINCIPAL_POINT:
+          sz.num_opencv_fisheye_split_fixed_principal_point = n;
+          break;
+        case FactorVariant::FIXED_POSE_FIXED_FOCAL_AND_EXTRA:
+          sz.num_opencv_fisheye_split_fixed_pose_fixed_focal_and_extra = n;
+          break;
+        case FactorVariant::FIXED_POSE_FIXED_PRINCIPAL_POINT:
+          sz.num_opencv_fisheye_split_fixed_pose_fixed_principal_point = n;
+          break;
+        case FactorVariant::FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+          sz.num_opencv_fisheye_split_fixed_focal_and_extra_fixed_principal_point =
+              n;
+          break;
+        case FactorVariant::FIXED_FOCAL_AND_EXTRA_FIXED_POINT:
+          sz.num_opencv_fisheye_split_fixed_focal_and_extra_fixed_point = n;
+          break;
+        case FactorVariant::FIXED_PRINCIPAL_POINT_FIXED_POINT:
+          sz.num_opencv_fisheye_split_fixed_principal_point_fixed_point = n;
+          break;
+        case FactorVariant::
+            FIXED_POSE_FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+          sz.num_opencv_fisheye_split_fixed_pose_fixed_focal_and_extra_fixed_principal_point =
+              n;
+          break;
+        case FactorVariant::FIXED_POSE_FIXED_FOCAL_AND_EXTRA_FIXED_POINT:
+          sz.num_opencv_fisheye_split_fixed_pose_fixed_focal_and_extra_fixed_point =
+              n;
+          break;
+        case FactorVariant::FIXED_POSE_FIXED_PRINCIPAL_POINT_FIXED_POINT:
+          sz.num_opencv_fisheye_split_fixed_pose_fixed_principal_point_fixed_point =
+              n;
+          break;
+        case FactorVariant::
+            FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT_FIXED_POINT:
+          sz.num_opencv_fisheye_split_fixed_focal_and_extra_fixed_principal_point_fixed_point =
+              n;
+          break;
+      }
+    }
+  }
+
+  void ExtractFocalAndExtra(const Camera& camera,
+                            std::vector<StorageType>& out) const override {
+    out.push_back(static_cast<StorageType>(camera.params[0]));  // fx
+    out.push_back(static_cast<StorageType>(camera.params[1]));  // fy
+    out.push_back(static_cast<StorageType>(camera.params[4]));  // k1
+    out.push_back(static_cast<StorageType>(camera.params[5]));  // k2
+    out.push_back(static_cast<StorageType>(camera.params[6]));  // k3
+    out.push_back(static_cast<StorageType>(camera.params[7]));  // k4
+  }
+
+  void ExtractPrincipalPoint(const Camera& camera,
+                             std::vector<StorageType>& out) const override {
+    out.push_back(static_cast<StorageType>(camera.params[2]));  // cx
+    out.push_back(static_cast<StorageType>(camera.params[3]));  // cy
+  }
+
+  void WriteFocalAndExtra(Camera& camera,
+                          const StorageType* data,
+                          size_t idx) const override {
+    const size_t base = idx * FocalAndExtraSize();
+    camera.params[0] = static_cast<double>(data[base + 0]);  // fx
+    camera.params[1] = static_cast<double>(data[base + 1]);  // fy
+    camera.params[4] = static_cast<double>(data[base + 2]);  // k1
+    camera.params[5] = static_cast<double>(data[base + 3]);  // k2
+    camera.params[6] = static_cast<double>(data[base + 4]);  // k3
+    camera.params[7] = static_cast<double>(data[base + 5]);  // k4
+  }
+
+  void WritePrincipalPoint(Camera& camera,
+                           const StorageType* data,
+                           size_t idx) const override {
+    camera.params[2] =
+        static_cast<double>(data[idx * PrincipalPointSize() + 0]);  // cx
+    camera.params[3] =
+        static_cast<double>(data[idx * PrincipalPointSize() + 1]);  // cy
+  }
+
+  void SetPoseNodes(caspar::GraphSolver& s,
+                    StorageType* data,
+                    size_t n) const override {
+    s.SetOpenCVFisheyePoseNodesFromStackedHost(data, 0, n);
+  }
+
+  void GetPoseNodes(caspar::GraphSolver& s,
+                    StorageType* data,
+                    size_t n) const override {
+    s.GetOpenCVFisheyePoseNodesToStackedHost(data, 0, n);
+  }
+
+  void SetFocalAndExtraNodes(caspar::GraphSolver& s,
+                             StorageType* data,
+                             size_t n) const override {
+    s.SetOpenCVFisheyeFocalAndExtraNodesFromStackedHost(data, 0, n);
+  }
+
+  void GetFocalAndExtraNodes(caspar::GraphSolver& s,
+                             StorageType* data,
+                             size_t n) const override {
+    s.GetOpenCVFisheyeFocalAndExtraNodesToStackedHost(data, 0, n);
+  }
+
+  void SetPrincipalPointNodes(caspar::GraphSolver& s,
+                              StorageType* data,
+                              size_t n) const override {
+    s.SetOpenCVFisheyePrincipalPointNodesFromStackedHost(data, 0, n);
+  }
+
+  void GetPrincipalPointNodes(caspar::GraphSolver& s,
+                              StorageType* data,
+                              size_t n) const override {
+    s.GetOpenCVFisheyePrincipalPointNodesToStackedHost(data, 0, n);
+  }
+
+  void SetCalibNodes(caspar::GraphSolver& s,
+                     StorageType* data,
+                     size_t n) const override {
+    s.SetOpenCVFisheyeCalibNodesFromStackedHost(data, 0, n);
+  }
+
+  void GetCalibNodes(caspar::GraphSolver& s,
+                     StorageType* data,
+                     size_t n) const override {
+    s.GetOpenCVFisheyeCalibNodesToStackedHost(data, 0, n);
+  }
+
+  void SetVariantFactors(caspar::GraphSolver& s,
+                         FactorVariant variant,
+                         const VariantData& d) const override {
+    const size_t n = d.num_factors;
+    switch (variant) {
+      // Merged variants: the calib index is the same as
+      // focal_and_extra_index, so no VariantData changes are needed for
+      // these cases.
+      case FactorVariant::BASE:
+        s.SetOpencvFisheyeNum(n);
+        s.SetOpencvFisheyePoseIndicesFromHost(d.pose_indices.data(), n);
+        s.SetOpencvFisheyeSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetOpencvFisheyeCalibIndicesFromHost(d.focal_and_extra_indices.data(),
+                                              n);
+        s.SetOpencvFisheyePointIndicesFromHost(d.point_indices.data(), n);
+        s.SetOpencvFisheyePixelDataFromStackedHost(d.pixels.data(), 0, n);
+        break;
+      case FactorVariant::FIXED_POSE:
+        s.SetOpencvFisheyeFixedPoseNum(n);
+        s.SetOpencvFisheyeFixedPoseSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetOpencvFisheyeFixedPoseCalibIndicesFromHost(
+            d.focal_and_extra_indices.data(), n);
+        s.SetOpencvFisheyeFixedPosePointIndicesFromHost(d.point_indices.data(),
+                                                       n);
+        s.SetOpencvFisheyeFixedPosePoseDataFromStackedHost(
+            d.const_poses.data(), 0, n);
+        s.SetOpencvFisheyeFixedPosePixelDataFromStackedHost(
+            d.pixels.data(), 0, n);
+        break;
+      case FactorVariant::FIXED_FOCAL_AND_EXTRA:
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraNum(n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraPoseIndicesFromHost(
+            d.pose_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraPrincipalPointIndicesFromHost(
+            d.principal_point_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraPointIndicesFromHost(
+            d.point_indices.data(), n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraFocalAndExtraDataFromStackedHost(
+            d.const_focal_and_extra.data(), 0, n);
+        s.SetOpencvFisheyeSplitFixedFocalAndExtraPixelDataFromStackedHost(
